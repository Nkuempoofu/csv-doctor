{
  "name": "csv-doctor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Browser-based CSV cleaner. Drag-drop a messy CSV, auto-detect issues, and export a clean version. Files never leave your browser.",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.14",
    "jsdom": "^29.1.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^4.1.6"
  }
}
